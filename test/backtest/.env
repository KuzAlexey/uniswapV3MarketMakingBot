# --- quotes ---
# Gap between a quote and the fair price, in ticks. One tick = 0.01%.
# Minimum 10: the pool grid does not allow bounds any closer.
SPREAD_TICKS=30

# Width of each of the two quotes, in ticks.
RANGE_TICKS=10

# Fraction of the gap at which we pull. 0.95 means "do not wait for the price
# to reach the quote, leave once it is 95% of the way there".
PULL_FRACTION=0.95

# Retrace of the pool price from its best, in ticks. The price entered our quote
# and turned back, so we pull rather than buy back what we just sold.
# A large value (say 1000) turns the trigger off.
POOL_ARBITRAGE_TRIGGER=0.001

# --- capital ---
# Starting wallet. Below roughly $18,000 gas eats the whole income.
START_WETH=2
START_USDC=5000

# --- costs ---
# Cost of on-chain operations on Arbitrum, in dollars. Counted per operation:
# a one-sided cycle is cheaper than a two-sided one, and the first placement
# needs no burn.
GAS_BURN=0.015
GAS_MINT=0.020

# Pool fee in hundredths of a basis point: 500 = 0.05%.
POOL_FEE=500

# Share of the fee that reaches liquidity providers.
# This pool sends a quarter to the protocol, hence 0.75.
LP_FEE_SHARE=0.75
