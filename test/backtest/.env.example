# --- котировки ---
# Отступ от справедливой цены, в тиках. Один тик = 0.01%.
# Минимум 10: сетка пула не позволяет ставить границы ближе.
SPREAD_TICKS=20

# Ширина каждой из двух котировок, в тиках.
RANGE_TICKS=10

# Доля отступа, при которой снимаемся. 0.7 значит "не ждать,
# пока цена дойдёт до котировки, уйти на 70% пути".
PULL_FRACTION=0.7

# Откат цены пула от лучшей достигнутой, в тиках. Цена зашла в нашу котировку
# и пошла обратно — снимаемся, чтобы не откупить проданное по той же цене.
# Большое значение (например 1000) выключает триггер.
POOL_ARBITRAGE_TRIGGER=5

# --- капитал ---
# Стартовый кошелёк. Ниже примерно $18 000 газ съедает весь доход.
START_WETH=1
START_USDC=2500

# --- издержки ---
# Стоимость операций на Arbitrum, в долларах. Считаем по факту: односторонний
# цикл дешевле двустороннего, а первое выставление обходится без снятия.
GAS_BURN=0.015
GAS_MINT=0.020

# Комиссия пула в сотых долях базисного пункта: 500 = 0.05%.
POOL_FEE=500

# Доля комиссии, достающаяся поставщикам ликвидности.
# На этом пуле протокол забирает четверть, отсюда 0.75.
LP_FEE_SHARE=0.75
