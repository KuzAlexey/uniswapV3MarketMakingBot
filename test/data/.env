# Период выгрузки, включительно с обеих сторон, в UTC.
# Сегодняшние сутки брать нельзя: и логи ноды, и архив Binance
# за текущий день ещё неполные.
START_DAY=2026-08-01
END_DAY=2026-08-07

# Uniswap
RPC_URL=https://arb1.arbitrum.io/rpc
POOL=0xC6962004f452bE9203591991D15f6b388e09E8D0

# Binance: символ в верхнем регистре, как в именах файлов архива
BINANCE_SYMBOL=ETHUSDC

# Hanji: ETH/USDC на Base. У рынка два адреса, и они не взаимозаменяемы.
# HANJI_MARKET — нижний CLOB, его знает HTTP API: оттуда берутся множители
# масштабирования цены и размера. Котируется и исполняется рынок по другому
# адресу, HANJI_PROXY ниже.
HANJI_API=https://api-base.hanji.io
HANJI_MARKET=0x7c976801c8589d924ce93bbcce6966d34edf91bf

# Стакан Hanji читается не из HTTP API, а с контракта: вся исполняемая
# ликвидность виртуальная и видна только через FastQuoterHelper. Его зовут
# по адресу прокси-агрегатора из /aggregators/markets.
BASE_RPC_URL=https://mainnet.base.org
HANJI_QUOTER=0xc032b6DFEc3511a00cdE9Ea341D140f4733609De
HANJI_PROXY=0x6a6951db3bb99f76a8ccb9f8a8399b613666298b

# Шаг сетки снимков. 15 минут — это 672 снимка за неделю и около 20 минут
# выгрузки; мельче упрёмся в ограничения публичного узла.
HANJI_BOOK_STEP_MIN=15
